{
  "name": "lan-video-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "tsx mock/server.ts",
    "mock:rx": "MOCK_ROLE=rx tsx mock/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-terms.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.mock.json --noEmit",
    "check:terms": "node scripts/check-terms.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "ws": "8.22.1"
  }
}
